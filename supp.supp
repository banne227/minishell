{
    ignore_libreadline
    Memcheck:Leak
    ...
    obj:/libreadline.so.
}
{
    readline_leak
    Memcheck:Leak
    ...
    fun:readline
}
{
    readline_add_history
    Memcheck:Leak
    ...
    fun:add_history
}
{
    usrbin
    Memcheck:Leak
    ...
    obj:/usr/bin/*
}
{
    fork_data_still_reachable
    Memcheck:Leak
    match-leak-kinds: reachable
    fun:malloc
    fun:main
}